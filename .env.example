# Persist the Docker API mode across every bare docker compose command.
# Trusted private-network Socketduct builders replace this with:
# COMPOSE_FILE=docker-compose.yml:docker-compose.socketduct.yml
COMPOSE_FILE=docker-compose.yml

# Docker network identity and address allocation. Without the optional network-name
# override, Compose preserves the legacy peakflow_builder_peakflow-builder name.
# To use an exact name, append docker-compose.network-name.yml to COMPOSE_FILE and set:
# BUILDER_NETWORK_NAME=tensorbuzz-builder-net
# The default project is peakflow_builder; COMPOSE_PROJECT_NAME explicitly overrides it.
BUILDER_NETWORK_SUBNET=58.0.0.0/24
DOCKER_SERVER_IPV4_ADDRESS=58.0.0.2
REGISTRY_CACHE_IPV4_ADDRESS=58.0.0.3

# Base mode ports for the TLS-protected Docker daemon.
# The Socketduct override clears this host binding.
HOST_PORT=8676
DOCKER_SERVER_TLS_PORT=8676

# Socketduct mode plaintext port inside the trusted private network only.
DOCKER_SERVER_SOCKETDUCT_PORT=2375

# Hard parent cgroup envelope for dockerd, nested build/service containers, and
# reclaimable nested filesystem cache. The same value controls RAM and total
# RAM-plus-swap, which disables swap. TensorBuzz admission remains a separate
# 16 GiB workload budget; the 4 GiB difference covers DinD daemon and
# kernel-accounted overhead.
DOCKER_SERVER_MEMORY_LIMIT=20g

# Choose the cache location before deployment. For an external cache, leave the
# profile empty and replace REGISTRY_CACHE_HOST. For the local cache, keep the
# logical host below and set COMPOSE_PROFILES=registry-cache.
COMPOSE_PROFILES=

# Registry cache endpoint as reached from docker-server. For the local cache,
# keep the logical service name registry-cache; otherwise set a reachable host.
REGISTRY_CACHE_HOST=registry-cache
REGISTRY_CACHE_PORT=5000
REGISTRY_PROXY_REMOTEURL=https://registry-1.docker.io

# Local registry-cache host publication. Loopback is the safe default.
REGISTRY_CACHE_BIND=127.0.0.1
REGISTRY_CACHE_BIND_PORT=5000

# Host directory containing Docker registry trust roots. Place each CA at:
#   <directory>/<registry-host>:<port>/ca.crt
DOCKER_REGISTRY_CERTS_DIR=./shared/docker-certs.d

# Local cache: enable the profile; the listener and publication use the
# REGISTRY_CACHE_* values above.
# COMPOSE_PROFILES=registry-cache
